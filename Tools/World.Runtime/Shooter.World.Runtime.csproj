<Project Sdk="Microsoft.NET.Sdk">
  <!-- Mirrors UnityProject/Assets/Shooter/World/Runtime/*.asmdef (Shooter.World.Runtime); verify_asmdef_graph.py keeps the references equal. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Shooter.World.Runtime</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../UnityProject/Assets/Shooter/World/Runtime/**/*.cs" />
    <ProjectReference Include="../Contracts/Shooter.Contracts.csproj" />
    <ProjectReference Include="../Game.Contracts/Shooter.Game.Contracts.csproj" />
  </ItemGroup>
</Project>
