<Project Sdk="Microsoft.NET.Sdk">
  <!-- Mirrors UnityProject/Assets/Shooter/Networking/*.asmdef (Shooter.Networking); verify_asmdef_graph.py keeps the references equal. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Shooter.Networking</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../UnityProject/Assets/Shooter/Networking/**/*.cs" />
    <ProjectReference Include="../Contracts/Shooter.Contracts.csproj" />
    <ProjectReference Include="../Bootstrap.Core/Shooter.Bootstrap.Core.csproj" />
    <ProjectReference Include="../Simulation/Shooter.Simulation.csproj" />
  </ItemGroup>
</Project>
