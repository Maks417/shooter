<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="[18.11.0]" />
    <PackageReference Include="xunit" Version="[2.9.3]" />
    <PackageReference Include="xunit.runner.visualstudio" Version="[4.0.1]" PrivateAssets="all" />
    <ProjectReference Include="../Contracts/Shooter.Contracts.csproj" />
    <ProjectReference Include="../Foundation/Shooter.Foundation.csproj" />
    <ProjectReference Include="../Generation/Shooter.Generation.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- View is presentation-owned; compile BCL-safe sources for pure tests. Motor/Combat/Pose/AI come from Foundation. -->
    <Compile Include="../../UnityProject/Assets/Shooter/Presentation/View/**/*.cs" Link="View/%(Filename)%(Extension)" />
    <Compile Include="../../UnityProject/Assets/Shooter/World/Streaming/**/*.cs" Link="WorldStreaming/%(Filename)%(Extension)" />
    <Compile Include="../../UnityProject/Assets/Shooter/World/Navigation/**/*.cs" Link="WorldNavigation/%(Filename)%(Extension)" />
    <Compile Include="../../UnityProject/Assets/Shooter/Presentation/Audio/**/*.cs" Link="Audio/%(Filename)%(Extension)" />
    <Compile Include="../../UnityProject/Assets/Shooter/Presentation/Fx/**/*.cs" Link="Fx/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
