<Project Sdk="Microsoft.NET.Sdk">
  <!-- Mirrors UnityProject/Assets/Shooter/Bootstrap/Core/*.asmdef (Shooter.Bootstrap.Core); verify_asmdef_graph.py keeps the references equal. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Shooter.Bootstrap.Core</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../UnityProject/Assets/Shooter/Bootstrap/Core/**/*.cs" />
  </ItemGroup>
</Project>
