{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaId": {
      "enum": [
        "shooter.recipe.map-compound.v1",
        "shooter.recipe.map-depot.v1",
        "shooter.recipe.map-oil.v1",
        "shooter.recipe.map-arena.v1"
      ]
    },
    "recipeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "generatorId": {
      "enum": [
        "map.compound",
        "map.depot",
        "map.oil",
        "map.arena"
      ]
    },
    "generatorVersion": {
      "const": "1.0.1"
    },
    "seed": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mapId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "maxLength": 48
        },
        "halfExtentMeters": {
          "type": "integer",
          "const": 128
        },
        "chunkSizeMeters": {
          "type": "integer",
          "const": 32
        },
        "navAdapterFormat": {
          "const": "unity.navmesh.bake.v1"
        },
        "navAdapterVersion": {
          "const": 1
        }
      },
      "required": [
        "mapId",
        "halfExtentMeters",
        "chunkSizeMeters",
        "navAdapterFormat",
        "navAdapterVersion"
      ]
    },
    "dependencies": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  },
  "required": [
    "schemaId",
    "recipeId",
    "generatorId",
    "generatorVersion",
    "seed",
    "parameters",
    "dependencies"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "generatorId": {
            "const": "map.compound"
          }
        }
      },
      "then": {
        "properties": {
          "schemaId": {
            "const": "shooter.recipe.map-compound.v1"
          },
          "parameters": {
            "properties": {
              "mapId": {
                "const": "training-compound"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "generatorId": {
            "const": "map.depot"
          }
        }
      },
      "then": {
        "properties": {
          "schemaId": {
            "const": "shooter.recipe.map-depot.v1"
          },
          "parameters": {
            "properties": {
              "mapId": {
                "const": "depot-yard"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "generatorId": {
            "const": "map.oil"
          }
        }
      },
      "then": {
        "properties": {
          "schemaId": {
            "const": "shooter.recipe.map-oil.v1"
          },
          "parameters": {
            "properties": {
              "mapId": {
                "const": "oil-depot"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "generatorId": {
            "const": "map.arena"
          }
        }
      },
      "then": {
        "properties": {
          "schemaId": {
            "const": "shooter.recipe.map-arena.v1"
          },
          "parameters": {
            "properties": {
              "mapId": {
                "not": {
                  "enum": [
                    "training-compound",
                    "depot-yard",
                    "oil-depot"
                  ]
                }
              }
            }
          }
        }
      }
    }
  ]
}
