{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaId": {
      "const": "shooter.recipe.weapon.v1"
    },
    "recipeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "generatorId": {
      "const": "geometry.weapon"
    },
    "generatorVersion": {
      "const": "1.0.3"
    },
    "seed": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "rifle",
            "pistol"
          ]
        }
      },
      "required": [
        "kind"
      ]
    },
    "dependencies": {
      "type": "array",
      "maxItems": 0
    }
  },
  "required": [
    "schemaId",
    "recipeId",
    "generatorId",
    "generatorVersion",
    "seed",
    "parameters",
    "dependencies"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
