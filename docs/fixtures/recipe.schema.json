{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaId": {
      "const": "shooter.recipe.box.v1"
    },
    "recipeId": {
      "type": "string"
    },
    "generatorId": {
      "const": "geometry.box"
    },
    "generatorVersion": {
      "type": "string"
    },
    "seed": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "parameters": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "widthMm": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "heightMm": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "depthMm": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "bevelMm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        }
      },
      "required": [
        "widthMm",
        "heightMm",
        "depthMm",
        "bevelMm"
      ]
    },
    "dependencies": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schemaId",
    "recipeId",
    "generatorId",
    "generatorVersion",
    "seed",
    "parameters",
    "dependencies"
  ]
}
