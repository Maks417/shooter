{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "manifestSchema": {
      "const": 1
    },
    "contentId": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "logicalAssetId": {
      "type": "string"
    },
    "recipeId": {
      "type": "string"
    },
    "sourceHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "generatorVersions": {
      "type": "object"
    },
    "seed": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "toolchainHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "buildPlatform": {
      "type": "string"
    },
    "visualProfile": {
      "type": "string"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "compressedBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 67108864
          },
          "uncompressedBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 67108864
          },
          "formatVersion": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "compression": {
            "const": "none"
          }
        },
        "required": [
          "kind",
          "path",
          "sha256",
          "compressedBytes",
          "uncompressedBytes",
          "formatVersion",
          "compression"
        ]
      }
    },
    "provenance": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceKind": {
          "type": "string"
        },
        "shippingAsset": {
          "const": false
        }
      },
      "required": [
        "sourceKind",
        "shippingAsset"
      ]
    }
  },
  "required": [
    "manifestSchema",
    "contentId",
    "logicalAssetId",
    "recipeId",
    "sourceHash",
    "generatorVersions",
    "seed",
    "toolchainHash",
    "buildPlatform",
    "visualProfile",
    "dependencies",
    "artifacts",
    "provenance"
  ]
}
